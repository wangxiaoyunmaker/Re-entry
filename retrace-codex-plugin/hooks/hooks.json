{
  "hooks": {
    "SessionStart": [{
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/hooks/emit-event.mjs\"",
        "async": true,
        "timeout": 2
      }]
    }],
    "UserPromptSubmit": [{
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/hooks/emit-event.mjs\"",
        "async": true,
        "timeout": 2
      }, {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/hooks/assess-submit.mjs\"",
        "timeout": 2
      }]
    }],
    "PreToolUse": [{
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/hooks/emit-event.mjs\"",
        "async": true,
        "timeout": 2
      }]
    }],
    "PostToolUse": [{
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/hooks/emit-event.mjs\"",
        "async": true,
        "timeout": 2
      }]
    }],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/hooks/emit-event.mjs\"",
        "async": true,
        "timeout": 2
      }]
    }],
    "PreCompact": [{
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/hooks/emit-event.mjs\"",
        "async": true,
        "timeout": 2
      }]
    }],
    "PostCompact": [{
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/hooks/emit-event.mjs\"",
        "async": true,
        "timeout": 2
      }]
    }],
    "SessionEnd": [{
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/hooks/emit-event.mjs\"",
        "timeout": 3
      }]
    }]
  }
}
